{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowAPIServerUploads",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::fundedwealth-uploads",
                "arn:aws:s3:::fundedwealth-uploads/*"
            ]
        }
    ]
}