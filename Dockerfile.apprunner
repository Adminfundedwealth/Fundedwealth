# ─────────────────────────────────────────────────────────────────────────────
# FundedWealth API Server — Docker image for AWS App Runner
# ─────────────────────────────────────────────────────────────────────────────
# Build:  docker build -f Dockerfile.apprunner -t fundedwealth-api .
# Run:    docker run -p 9000:9000 --env-file .env fundedwealth-api
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-slim AS builder

# cache-bust: nodemailer bundled into dist as of 2026-07-15
# Install pnpm directly via npm to match the workspace lockfile version
RUN npm install -g pnpm@9

WORKDIR /app

# Copy workspace config first for cache efficiency
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json tsconfig.base.json ./

# Copy workspace package manifests
COPY lib/db/package.json lib/db/tsconfig.json ./lib/db/
COPY lib/api-zod/package.json lib/api-zod/tsconfig.json ./lib/api-zod/
COPY lib/api-client-react/package.json lib/api-client-react/tsconfig.json ./lib/api-client-react/
COPY lib/integrations-gemini-ai/package.json lib/integrations-gemini-ai/tsconfig.json ./lib/integrations-gemini-ai/
COPY lib/products/package.json lib/products/tsconfig.json ./lib/products/
COPY artifacts/api-server/package.json artifacts/api-server/tsconfig.json ./artifacts/api-server/
COPY artifacts/fundedwealth/package.json ./artifacts/fundedwealth/
COPY artifacts/mockup-sandbox/package.json ./artifacts/mockup-sandbox/
COPY scripts/package.json ./scripts/

# Install dependencies and keep the pnpm store inside the build context so runner can reuse it
RUN pnpm install --no-frozen-lockfile --prod=false --store ./.pnpm

# Copy source code
COPY lib/ ./lib/
COPY artifacts/api-server/ ./artifacts/api-server/

# Build the API server (esbuild bundles everything into dist/index.mjs)
RUN pnpm --filter @workspace/api-server run build

# ─── Production image ─────────────────────────────────────────────────────────
FROM node:20-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built output, workspace node_modules (hoisted), and api-server's own node_modules
COPY --from=builder /app/artifacts/api-server/dist ./dist
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/artifacts/api-server/node_modules ./artifacts/api-server/node_modules
COPY --from=builder /app/.pnpm ./.pnpm
ENV NODE_ENV=production
ENV PORT=9000

EXPOSE 9000

# Health check for App Runner
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const http = require('http'); http.get('http://localhost:9000/api/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1));"

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
