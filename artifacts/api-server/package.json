    "@supabase/supabase-js": "^2.33.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "eventemitter3": "^5.0.1",
    "express": "^5",
    "express-rate-limit": "^8.3.2",
